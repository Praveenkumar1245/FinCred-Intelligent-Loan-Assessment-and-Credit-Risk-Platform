# FinCred AI — Environment Variables Configuration

# Flask Application Secret Key (generate a secure random string for production)
SECRET_KEY=fincred-ai-production-super-secret-key-change-in-production

# SQLite Database Location
DATABASE_URL=sqlite:///instance/fincred.db

# Flask Server Port
PORT=5000
FLASK_DEBUG=1

# Tesseract OCR Executable Path (Windows Default)
# If Tesseract is installed via installer (e.g. from UB-Mannheim/tesseract/wiki):
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
